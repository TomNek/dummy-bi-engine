{
  "productName": "Semantic Migration Workbench",
  "version": "0.2.3",
  "identifier": "com.dax-to-sql.open-core",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../dax_ui/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Semantic Migration Workbench",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/dax_backend"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMTQxMTg0MjFCMEFEQTMKUldTanJiQWhoQkVVc21lbFB2cGxyMDY3VzdxTkVSbWR6bUNSd0JWaTV5a2oxNDNTMEwzTHdYbkcK",
      "endpoints": [
        "https://raw.githubusercontent.com/TomNek/dummy-bi-engine/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
